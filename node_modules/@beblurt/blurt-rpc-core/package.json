{
  "name": "@beblurt/blurt-rpc-core",
  "version": "0.1.0",
  "description": "Generic JSON-RPC 2.0 core for transports, retries, endpoint pools, hooks and observability.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/blurt-blockchain/blurt-rpc-core.git"
  },
  "bugs": {
    "url": "https://gitlab.com/blurt-blockchain/blurt-rpc-core/-/issues"
  },
  "homepage": "https://gitlab.com/blurt-blockchain/blurt-rpc-core#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "API.md",
    "DESIGN_DECISIONS.md",
    "ROADMAP.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "lint:fix": "eslint src tests --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "json-rpc",
    "rpc",
    "typescript",
    "transport",
    "failover",
    "retry"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  }
}
