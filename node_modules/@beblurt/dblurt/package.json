{
  "name": "@beblurt/dblurt",
  "version": "0.17.0",
  "description": "Modern Blurt blockchain client library (JSON-RPC connector) for Node.js >=18 and browsers with native fetch",
  "author": "@beblurt (https://beblurt.com/@beblurt)",
  "license": "BSD-3-Clause-No-Military-License",
  "main": "./lib/index-node",
  "types": "./lib/index",
  "typings": "./lib/index",
  "browser": {
    "./lib/index-node": "./dist/dblurt.js",
    "./src/index-node": "./dist/dblurt.js",
    "./src/version": "./lib/version.js"
  },
  "files": [
    "dist/*",
    "lib/*",
    "guide/*",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/beblurt/dblurt"
  },
  "bugs": {
    "url": "https://gitlab.com/beblurt/dblurt/issues"
  },
  "homepage": "https://gitlab.com/beblurt/dblurt#readme",
  "scripts": {
    "lint": "make lint",
    "typecheck": "make typecheck",
    "test": "make ci-test",
    "test:account-history-contract": "mocha --exit --require ts-node/register -r test/_node.js test/account_history_api_contract.ts",
    "test:account-history-smoke": "mocha --exit --require ts-node/register -r test/_node.js test/account_history_api_smoke.ts",
    "test:blockchain-contract": "mocha --exit --require ts-node/register -r test/_node.js test/blockchain_contract.ts",
    "test:blockchain-smoke": "mocha --exit --require ts-node/register -r test/_node.js test/blockchain_smoke.ts",
    "test:client-contract": "mocha --exit --require ts-node/register -r test/_node.js test/client_contract.ts",
    "test:condenser-contract": "mocha --exit --require ts-node/register -r test/_node.js test/condenser_api_contract.ts",
    "test:crypto-real": "mocha --exit --require ts-node/register -r test/_node.js test/crypto_real_integration.ts",
    "test:database-contract": "mocha --exit --require ts-node/register -r test/_node.js test/database_api_contract.ts",
    "test:nexus-bridge-contract": "mocha --exit --require ts-node/register -r test/_node.js test/nexus_bridge_contract.ts",
    "test:nexus-bridge-smoke": "mocha --exit --require ts-node/register -r test/_node.js test/nexus_bridge_smoke.ts",
    "test:tools-contract": "mocha --exit --require ts-node/register -r test/_node.js test/tools_helper_contract.ts",
    "test:tools-smoke": "mocha --exit --require ts-node/register -r test/_node.js test/tools_helper_smoke.ts",
    "build": "make all",
    "release": "commit-and-tag-version",
    "docs": "make docs",
    "docs:check": "make docs-check",
    "docs:site:dev": "vitepress dev site",
    "docs:site:build": "npm run docs:ai && vitepress build site",
    "docs:site:preview": "vitepress preview site",
    "parity:audit": "node scripts/platform-parity-audit.js",
    "coverage": "make coverage",
    "docs:check:ci": "DBLURT_DOCS_CHECK_SKIP_LIVE_EXAMPLES=1 make docs-check",
    "docs:public:build": "node scripts/build-docs-public.js",
    "docs:ai": "node scripts/generate-ai-docs.js",
    "docs:ai:check": "node scripts/generate-ai-docs.js --check",
    "docs:readme-links": "node scripts/check-readme-external-links.js",
    "csp:check": "node scripts/check-csp-runtime.js",
    "package:check": "node scripts/check-package-tarball.js",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run build && npm run docs:check:ci && npm run docs:ai:check && npm run csp:check && npm run package:check"
  },
  "keywords": [
    "blurt",
    "blurt connector",
    "blurt blockchain connector",
    "blurt rpc nodes",
    "blurt rpc client",
    "blurt blockchain",
    "blurt library",
    "blurt client library",
    "blurt typescript",
    "dblurt"
  ],
  "dependencies": {
    "@beblurt/blurt-rpc-core": "^0.1.0",
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^1.7.1",
    "@types/bytebuffer": "^5.0.49",
    "@types/node": "^18.19.123",
    "aes-js": "^3.1.2",
    "bs58": "^4.0.1",
    "bytebuffer": "^5.0.1",
    "jsbi": "^3.1.4",
    "long": "^5.3.2"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "browserify": "^17.0.1",
    "c8": "^11.0.0",
    "commit-and-tag-version": "^12.7.3",
    "derequire": "^2.0.6",
    "dts-generator": "^3.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prefer-arrow": "^1.1.7",
    "mocha": "^11.7.6",
    "ts-node": "^10.9.2",
    "typedoc": "^0.26.11",
    "typescript": "^5.6.3",
    "uglify-js": "^3.19.3",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "defaults and supports fetch and supports abortcontroller"
  ]
}
