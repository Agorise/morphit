{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "checkJs": false
  },
  "include": [
    "scripts/**/*.ts",
    "src/**/*.d.ts"
  ]
}
