{
  "name": "morphit-web",
  "version": "1.11.4",
  "private": true,
  "type": "module",
  "description": "Morphit web frontend — SvelteKit SSG, PWA, No-JS read-only paths",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite dev --host",
    "prebuild": "npm run build:sitemap && npm run build:llms-full",
    "build": "vite build",
    "postbuild": "npm run build:verify-json",
    "preview": "vite preview --host",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:manifest": "node scripts/build-manifest.mjs",
    "build:sitemap": "node ../../scripts/build-sitemap.mjs",
    "build:llms-full": "node ../../scripts/build-llms-full.mjs",
    "build:verify-json": "node ../../scripts/build-verify-json.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.0.0 || ^14.0.0",
    "postcss": "^8.4.49",
    "prettier": "~3.6.2",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "svelte": "^5.1.16",
    "svelte-check": "^4.0.7",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@beblurt/dblurt": "^0.17.0",
    "@morphit/asset-registry": "*",
    "@morphit/indexer-client": "*",
    "@morphit/release-schema": "*",
    "@noble/secp256k1": "^2.1.0",
    "@scure/bip39": "^1.4.0",
    "bytebuffer": "^5.0.1",
    "jspdf": "4.2.1",
    "libsodium-wrappers-sumo": "0.7.15",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "svelte-i18n": "^4.0.1"
  }
}
