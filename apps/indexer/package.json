{
	"name": "morphit-indexer",
	"version": "1.21.0",
	"private": true,
	"type": "module",
	"description": "Morphit chain indexer — reads morphit_* ops from Blurt, maintains queryable state in Postgres",
	"license": "AGPL-3.0-or-later",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"format": "prettier --write .",
		"lint": "tsx ../../scripts/lint-gate-smoke.ts",
		"migrate": "tsx src/db/migrations.ts",
		"start": "tsx src/main.ts",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@beblurt/dblurt": "^0.17.0",
		"@hono/node-server": "^1.19.17",
		"@morphit/asset-registry": "*",
		"@morphit/hidden-transport": "*",
		"@morphit/net-defense": "*",
		"@morphit/node-health": "*",
		"@morphit/operator-config": "*",
		"@morphit/release-schema": "*",
		"@morphit/rpc-pool": "*",
		"@noble/curves": "1.9.7",
		"@noble/hashes": "^1.8.0",
		"hono": "^4.13.12",
		"pg": "^8.13.0",
		"tsx": "^4.19.0",
		"undici": "^7.29.1",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@morphit/indexer-client": "*",
		"@types/node": "^22.9.0",
		"@types/pg": "^8.11.10",
		"prettier": "~3.6.2",
		"typescript": "^5.6.3",
		"vitest": "^2.1.9"
	}
}
