{
	"name": "morphit-relay",
	"version": "1.21.10",
	"description": "Morphit posting relay — pays Blurt account-creation fees on behalf of new users. Never holds user private keys.",
	"type": "module",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"format": "prettier --write .",
		"lint": "tsx ../../scripts/lint-gate-smoke.ts",
		"start": "tsx src/main.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@beblurt/dblurt": "^0.17.0",
		"@hono/node-server": "^1.19.17",
		"@morphit/hidden-transport": "*",
		"@morphit/operator-config": "*",
		"@morphit/rpc-pool": "*",
		"@session.js/client": "0.0.57",
		"@session.js/errors": "1.0.11",
		"@session.js/keypair": "1.0.8",
		"@session.js/mnemonic": "1.0.6",
		"@session.js/types": "1.0.19",
		"hono": "^4.13.12",
		"pg": "^8.13.0",
		"tsx": "^4.19.0",
		"undici": "^7.29.1",
		"web-push": "^3.6.7",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@types/node": "^22.9.0",
		"@types/web-push": "^3.6.4",
		"prettier": "~3.6.2",
		"typescript": "^5.6.3",
		"vitest": "^2.1.9"
	}
}
