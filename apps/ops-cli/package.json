{
  "name": "morphit-ops",
  "version": "0.1.0",
  "description": "Morphit operator CLI — status, drain queue, signups, abuse alerts. Read-mostly view into the indexer + relay shared database.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "morphit-ops": "src/main.ts"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sveltejs/kit": "0.0.30",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "pg": "^8.13.0",
    "svelte-i18n": "3.7.1",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "prettier": "~3.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6"
  }
}
