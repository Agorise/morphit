# Morphit — npm settings for every npm / npx run inside this install.
#
# update-notifier=false: npm's "New major version of npm available! … To update
# run: npm install -g npm@…" notice must never appear. It prints when the npm or
# npx process that STARTED a command exits — e.g. at the very end of
# `npx morphit-ops install` or `npx morphit-ops upgrade` — so an environment
# variable set by morphit-ops itself comes too late to reach it. A project
# .npmrc is read by that outer npm at startup, whichever user runs it (sudo -u
# resets the environment, not the working directory). Following the notice is
# harmful: Morphit ships and pins its own Node/npm, and a global npm upgrade can
# break the install.
update-notifier=false
# fund=false: no "packages are looking for funding" noise after npm install.
fund=false
