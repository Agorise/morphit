# {{ ansible_managed }}
# Config for morphit-ipfs-pin.sh (the release-pinning service).
MORPHIT_RELEASE_URL={{ morphit_ipfs_release_url }}
IPFS_PATH={{ morphit_ipfs_repo }}
MORPHIT_IPFS_PIN_TIMEOUT={{ morphit_ipfs_pin_timeout }}
# yes on a tor-only node: the IPNS rebroadcast does not write to the public DHT
# from this box. Its Kubo runs with Routing.Type=none.
MORPHIT_IPFS_HIDDEN_ONLY={{ 'yes' if (morphit_tor_only | default(false) | bool) else 'no' }}
