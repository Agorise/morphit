# Managed by Ansible — MCP server config (§45).
#
# The morphit-mcp server is a read-only HTTP client of a Morphit
# instance's public /v1 API.  It holds no DB connection and no keys.
#
# MORPHIT_MCP_INSTANCE_URL is which instance the MCP server surfaces
# to AI agents.  We point it at THIS node's own public origin so a
# self-hosted MCP serves the operator's own federated orderbook
# (otherwise the server defaults to https://morphit.io and would
# surface that instance instead).
MORPHIT_MCP_INSTANCE_URL={{ morphit_mcp_instance_url }}

# ─── HTTP transport (the unit runs MORPHIT_MCP_TRANSPORT=http) ──────
# This file is read AFTER the unit's Environment= defaults, so these
# OVERRIDE them.  Canonical topology (§32): the dockerized BunkerWeb
# frontend reaches the MCP on the host across the Docker bridge, so —
# exactly like the relay/indexer — we bind all interfaces and let UFW
# (default-deny + the bunkerweb_net allow the bunkerweb role adds for
# this port) keep the public out.  A bare-metal operator fronting the
# MCP with host nginx can set morphit_mcp_bind_host: 127.0.0.1 instead.
MORPHIT_MCP_HTTP_HOST={{ morphit_mcp_bind_host }}
MORPHIT_MCP_HTTP_PORT={{ morphit_mcp_bind_port }}
{% if morphit_mcp_bind_host in ['0.0.0.0', '::'] %}
# 0.0.0.0/:: binds all interfaces; the MCP is fail-closed and refuses
# that without an explicit opt-in.  Safe here because UFW restricts the
# port to the bunkerweb_net CIDR — the firewall is the protection, the
# same posture as the relay/indexer 0.0.0.0 bind.  (A loopback or
# private/bridge bind does NOT need this flag.)
MORPHIT_MCP_ALLOW_PUBLIC_BIND=1
{% endif %}

# ─── Advanced overrides (safe defaults in the source) ──────────────
# DNS-rebinding Host allowlist (comma-separated).  Default auto-includes
# the bound host:port plus the loopback forms; the reverse proxy is
# configured to present a loopback Host upstream so this just works.
# MORPHIT_MCP_ALLOWED_HOSTS=127.0.0.1:8124,localhost:8124
#
# Origin allowlist — empty (default) rejects ANY browser Origin; set
# only if a trusted browser app must call the MCP directly:
# MORPHIT_MCP_ALLOWED_ORIGINS=
#
# Per-client rate limit (token bucket, requests/minute).  NOTE: behind a
# shared reverse proxy the MCP currently keys on the proxy's address, so
# this acts as a COLLECTIVE limit for all proxied agents — raise it on a
# busy public instance.
# MORPHIT_MCP_RATE_LIMIT_PER_MIN=120
# Hard request-body cap (bytes):
# MORPHIT_MCP_MAX_BODY_BYTES=262144
# Max concurrent TCP connections:
# MORPHIT_MCP_MAX_CONNECTIONS=64
