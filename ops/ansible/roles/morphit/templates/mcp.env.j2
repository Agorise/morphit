# Managed by Ansible — MCP server config (§45).
#
# The morphit-mcp server is a read-only HTTP client of a Morphit
# instance's public /v1 API.  It holds no DB connection and no keys.
#
# MORPHIT_MCP_INSTANCE_URL is which instance the MCP server surfaces
# to AI agents.  We point it at THIS node's own public origin so a
# self-hosted MCP serves the operator's own federated orderbook
# (otherwise the server defaults to https://morphit.io and would
# surface that instance instead).
MORPHIT_MCP_INSTANCE_URL={{ morphit_mcp_instance_url }}
