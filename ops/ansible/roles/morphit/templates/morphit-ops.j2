#!/bin/sh
# morphit-ops — global launcher for the Morphit operations CLI.
#
# Installed by the `morphit` Ansible role so that `sudo morphit-ops <command>`
# works from ANY directory (register / upgrade / harden / status / doctor / …).
# Without this, the CLI was only reachable as `npx morphit-ops` from inside the
# source checkout, so a freshly-installed operator hit "morphit-ops: command not
# found" the moment the wizard told them to run `sudo morphit-ops register`.
#
# It runs the CLI from the DEPLOYED repo, so the tool resolves its instance
# config under {{ morphit_repo_path }} no matter where the caller invoked it.
# The CLI runs from TypeScript source via tsx (a production dependency) — this
# mirrors the role's own verify step:
#     npm exec --offline --workspace apps/ops-cli morphit-ops -- --help
set -eu
cd "{{ morphit_repo_path }}" || {
	echo "morphit-ops: Morphit is not installed at {{ morphit_repo_path }}." >&2
	exit 1
}

# status/doctor need the indexer DB URL, which lives in /etc/morphit/indexer.env
# (the systemd unit's EnvironmentFile).  Read it INERTLY with sed and export it —
# NEVER `.`-source that file: an unquoted value with spaces (a marketplace name /
# tagline is valid there for systemd) would execute under `set -e` and abort the
# launcher (cp661).  OS env already set wins; we only fill a missing value.
_indexer_env="/etc/morphit/indexer.env"
if [ -z "${MORPHIT_INDEXER_DATABASE_URL:-}" ] && [ -r "$_indexer_env" ]; then
	_dburl=$(sed -n 's/^MORPHIT_INDEXER_DATABASE_URL=//p' "$_indexer_env" | tail -1) || _dburl=""
	# Strip optional surrounding quotes (systemd EnvironmentFile allows them).
	_dburl=$(printf '%s' "$_dburl" | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/")
	if [ -n "$_dburl" ]; then export MORPHIT_INDEXER_DATABASE_URL="$_dburl"; fi
fi

exec npm exec --offline --workspace apps/ops-cli morphit-ops -- "$@"
