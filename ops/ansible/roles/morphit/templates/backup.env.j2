# Managed by Ansible — see ops/backup/backup.env.example in the
# repo for the canonical shape.  Every variable here is read by
# ops/backup/morphit-backup.sh.

# Local backup staging dir (encrypted file written here, then
# pushed off-host).
BACKUP_DIR={{ morphit_service_home }}/backups

# How many days of backups to keep locally + remotely.
RETAIN_DAYS={{ morphit_backup_retention_days }}

# Postgres connection.
DB_NAME={{ postgres_indexer_db }}
DB_USER={{ postgres_indexer_user }}
DB_HOST=localhost
DB_PORT={{ postgres_port }}

# age public key — backups are encrypted before pushed off-host
# (§37.12).  The matching private key MUST live OFF the morphit
# host or backups are no defense.
AGE_RECIPIENT={{ morphit_backup_age_recipient }}

# Off-host destination — rsync/scp target (§31).  The morphit-
# backup.service unit's User= owns this and uses
# {{ morphit_backup_ssh_key_path }} for auth.
REMOTE_DESTINATION={{ morphit_backup_remote_destination }}
SSH_KEY={{ morphit_backup_ssh_key_path }}
