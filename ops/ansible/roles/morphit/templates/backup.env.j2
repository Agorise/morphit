# Managed by Ansible — see ops/backup/backup.env.example in the
# repo for the canonical shape.  Every variable here is read by
# ops/backup/morphit-backup.sh.
#
# Optional fields (AGE_RECIPIENT, REMOTE_DESTINATION, SSH_KEY,
# DB_HOST, DB_PORT) are emitted only when set in group_vars.  An
# empty placeholder string would be skipped by the script anyway,
# but omitting the line entirely keeps the file readable.

# ─── REQUIRED ─────────────────────────────────────────────────────

# Local backup staging dir (encrypted file written here, then
# optionally pushed off-host via rsync).
BACKUP_DIR={{ morphit_service_home }}/backups

# How many days of LOCAL backups to keep.  Remote retention is
# the operator's separate concern (rsync does not delete).
RETAIN_DAYS={{ morphit_backup_retention_days }}

# Postgres connection.
DB_NAME={{ postgres_indexer_db }}
DB_USER={{ postgres_indexer_user }}

# ─── OPTIONAL — Postgres host/port override ──────────────────────
# Default (empty) uses Unix-socket peer auth.  Uncomment if
# Postgres runs on a different host.
{% if postgres_listen_addresses and postgres_listen_addresses != '127.0.0.1' %}
DB_HOST=127.0.0.1
DB_PORT={{ postgres_port }}
{% endif %}

# ─── OPTIONAL — Docker-aware backup ──────────────────────────────
# Set morphit_db_container in group_vars when Postgres runs in a
# Docker container (BunkerWeb / docker-compose); the dump then runs
# THROUGH `docker exec <container> pg_dump …` against the container's
# own local socket.  Leave empty for a host Postgres (the Ansible
# default installs Postgres on the host, so this is normally unset).
{% if morphit_db_container | default('') | length > 0 %}
DB_CONTAINER={{ morphit_db_container }}
{% endif %}

# ─── OPTIONAL — age encryption ────────────────────────────────────
# Leave unset to write plaintext .sql.gz files.  When set, every
# backup is encrypted with `age -r ...` before write.  The matching
# PRIVATE key MUST live OFF this host (§37.12).
{% if morphit_backup_age_recipient | default('') | length > 0 %}
AGE_RECIPIENT={{ morphit_backup_age_recipient }}
{% endif %}

# ─── OPTIONAL — off-host push ─────────────────────────────────────
# Leave unset to keep backups local-only.  When set, every backup
# is rsync'd to the destination after the local write.  Rsync
# errors are non-fatal — the local copy is the source-of-truth.
{% if morphit_backup_remote_destination | default('') | length > 0 %}
REMOTE_DESTINATION={{ morphit_backup_remote_destination }}
{% if morphit_backup_ssh_key_path | default('') | length > 0 %}
SSH_KEY={{ morphit_backup_ssh_key_path }}
{% endif %}
{% endif %}
