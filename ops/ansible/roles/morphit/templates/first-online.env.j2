# Managed by Ansible — configuration for morphit-first-online.sh, which finishes
# the network-dependent tail of the install the first time this box sees the
# internet.  See ops/first-online/morphit-first-online.sh.
MORPHIT_DOMAIN={{ morphit_domain }}
MORPHIT_ACME_EMAIL={{ tls_acme_email }}
# yes → auto-publish the on-chain operator registration when the box first comes
# online (opt-in via the installer wizard).  no → the operator registers by hand
# with `morphit-ops register`.
MORPHIT_AUTO_REGISTER={{ 'yes' if (morphit_auto_register | default(false) | bool) else 'no' }}
MORPHIT_TLS_STAGING={{ 'yes' if (tls_use_staging | default(false) | bool) else 'no' }}
MORPHIT_OPS_DIR={{ morphit_repo_path }}
