# Infra/identity values loadInstanceEnv reads via parseEnv (EVERY key, not the
# operator-config allowlist; OS env wins, file fills what is missing).
#
# The relay + indexer services get these from /etc/morphit/relay.env.  This file
# exists so a manual `sudo morphit-ops register` — which reads
# {{ morphit_repo_path }}/morphit.env, NOT /etc/morphit/*.env — can find the relay
# account and its active-key file.  These are an account name and a filesystem
# path, NOT secrets: the active key itself stays in the 0400 keystore that
# MORPHIT_RELAY_ACTIVE_KEY_FILE points at.
MORPHIT_RELAY_ACCOUNT={{ morphit_operator_account }}
MORPHIT_RELAY_ACTIVE_KEY_FILE={{ morphit_relay_keystore_path }}
