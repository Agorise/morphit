# Managed by Ansible — see ops/env/indexer.env.example in the
# repo for the exhaustive reference.  Every variable here
# corresponds to one parsed by apps/indexer/src/config/index.ts.

# ─── Database ───────────────────────────────────────────────────
MORPHIT_INDEXER_DATABASE_URL=postgresql://{{ postgres_indexer_user }}:{{ postgres_indexer_password }}@localhost:{{ postgres_port }}/{{ postgres_indexer_db }}
MORPHIT_INDEXER_DB_POOL_MAX=10

# ─── Chain identity ─────────────────────────────────────────────
MORPHIT_INDEXER_CHAIN_ID=cd8d90f29ae273abec3eaa7731e25934c63eb654d55080caff2ebb7f5df6381f
MORPHIT_INDEXER_RPC_ENDPOINTS={{ morphit_indexer_blurt_rpc_endpoints }}

# ─── Public origin (REQUIRED — has no Zod default) ──────────────
# The indexer's externally-visible base URL.  Used in /v1/instance
# response, in RSS feed self-URLs, and as the origin-pin for chat
# signatures.  Cp52 deep-deep ANSIBLE-A3 closure: previously
# missing from this template, so the indexer would fail Zod
# validation at startup with `MORPHIT_INDEXER_PUBLIC_ORIGIN
# required` until the operator manually added it.  Now templated
# from {{ morphit_domain }}.
MORPHIT_INDEXER_PUBLIC_ORIGIN=https://{{ morphit_domain }}

# ─── Trust anchors (REQUIRED — has no Zod default) ──────────────
# The @morphit account's posting pubkey, used to verify
# morphit_release_v1 ops.  MUST match the frontend's
# MORPHIT_OFFICIAL_POSTING_PUBKEY — same trust anchor at both
# layers.  The value below is the canonical @morphit posting key
# as of Part 122.  If a key rotation has happened, override via
# group_vars/all.yml: `morphit_official_posting_pubkey: BLT...`.
# Cp52 deep-deep ANSIBLE-A3 closure: previously missing.
MORPHIT_INDEXER_OFFICIAL_POSTING_PUBKEY={{ morphit_official_posting_pubkey | default('BLT6CVC6C3PgmMe5xDtxFXJvGHaLnUTtcsK1ghHomDqLPWW7yeMp9') }}

# ─── HTTP bind ──────────────────────────────────────────────────
MORPHIT_INDEXER_LISTEN_HOST={{ morphit_indexer_bind_host }}
MORPHIT_INDEXER_LISTEN_PORT={{ morphit_indexer_bind_port }}

# ─── MCP discovery (§45) ────────────────────────────────────────
# Advertise the node's MCP endpoint in /v1/instance.mcp_url (built from
# the public origin above + /mcp) so other AI agents discover it
# federation-wide.  True only when the MCP is BOTH enabled and
# advertise-opted-in, so a disabled MCP is never announced.  The
# BunkerWeb frontend proxies the live /mcp route.
MORPHIT_MCP_ADVERTISE={{ (morphit_mcp_enabled | bool and morphit_mcp_advertise | bool) | string | lower }}

# ─── Identity ───────────────────────────────────────────────────
MORPHIT_INSTANCE_OPERATOR_TAG={{ morphit_operator_tag }}
MORPHIT_INDEXER_OPERATOR_ACCOUNT_NAME={{ morphit_operator_account }}
# cp673: the relay account this indexer publishes in /v1/instance.relay_account.
# It MUST equal the account that signed this instance's on-chain registration,
# or peers reject the probe with a relay_account mismatch. Defaults to the
# canonical 'morphit-relay' if unset — wrong for every non-canonical instance —
# so it is set explicitly here (the ops-cli wizard already does the same).
MORPHIT_INDEXER_RELAY_ACCOUNT={{ morphit_operator_account }}
# Friendly title + one-line description shown on the shared /instances
# directory (this indexer publishes them in /v1/instance; other nodes cache
# them for their federated list). The wizard collects these next to the domain.
# Double-quoted so a value with spaces survives the unit's `. "$f"` shell-source
# (bash + Node parseEnv both strip the quotes); shell metacharacters unsupported.
{% if morphit_instance_name | default('') | length > 0 %}
MORPHIT_INSTANCE_NAME="{{ morphit_instance_name }}"
{% endif %}
{% if morphit_instance_tagline | default('') | length > 0 %}
MORPHIT_INSTANCE_TAGLINE="{{ morphit_instance_tagline }}"
{% endif %}
# Operator contact link — drives the "Contact this operator" link on the
# /instances card. The wizard collects an optional Matrix account and stores it
# as a matrix.to URL; unset means the operator gave none (the link is omitted).
{% if morphit_instance_contact_url | default('') | length > 0 %}
MORPHIT_INSTANCE_CONTACT_URL="{{ morphit_instance_contact_url }}"
{% endif %}
# Where BLURT listing fees are paid (the operator earns these). Unset defaults
# to the shared @morphit-fees treasury; the wizard sets it to your own account
# so a federation operator earns their 90% share.
MORPHIT_INDEXER_FEE_RECIPIENT={{ morphit_fee_recipient | default('@morphit-fees') }}

# ─── Asset + payment-method policy (Memory #25, cp6 + cp208) ───
MORPHIT_INDEXER_DISABLED_ASSETS={{ morphit_indexer_disabled_assets }}
MORPHIT_INDEXER_DISABLED_PAYMENT_METHODS={{ morphit_indexer_disabled_payment_methods }}

# ─── Attestation phase (§20) ────────────────────────────────────
MORPHIT_INDEXER_ATTESTATION_PHASE={{ morphit_indexer_attestation_phase }}

# Other knobs (federation seed list, fee thresholds, etc.) live
# in ops/env/indexer.env.example — add them here using the same
# {{ "{{ ansible_var }}" }} pattern as needed.

# cp696 — the indexer's /v1/health probes the co-located relay's /v1/health to
# report relay.up. Without this it defaults empty and probeRelay short-circuits
# to up:false on every node (the relay is fine, the indexer just never asked).
MORPHIT_INDEXER_RELAY_HEALTH_URL=http://127.0.0.1:{{ morphit_relay_bind_port | default(8080) }}/v1/health

# cp704 — Layer 6: probe hidden-service PEERS through the local Tor/I2P proxies
# so their federated-directory status is REAL (not a blanket listing). Empty a
# value to disable that network; a down proxy just falls the peer back to
# listed-not-probed — it never marks an onion peer 'unreachable' for OUR daemon
# being offline.
MORPHIT_INDEXER_TOR_SOCKS=127.0.0.1:{{ morphit_tor_socks_port | default(9050) }}
MORPHIT_INDEXER_I2P_HTTP_PROXY=127.0.0.1:{{ morphit_i2p_http_proxy_port | default(4444) }}

# cp708 — the /v1/health `system.disk_*` figure measures the filesystem that
# holds the node's DATA (the unbounded grower: Postgres / the chain index),
# not always `/`. On a single-volume box this is the same mount as `/`; on a
# split-volume node (a dedicated data mount) it tracks the volume that actually
# fills. Defaults to the Postgres data directory's parent — statfs resolves it
# to whichever mount holds the DB. Override morphit_health_disk_path to point
# at a different data volume. Must be an ABSOLUTE path; a bad value safely
# falls back to `/` in code, so the figure never blanks.
MORPHIT_HEALTH_DISK_PATH={{ morphit_health_disk_path | default('/var/lib/postgresql') }}
