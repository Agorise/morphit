# Managed by Ansible — see ops/env/relay.env.example in the repo
# for the exhaustive reference.  Every variable here corresponds
# to one parsed by apps/relay/src/config/index.ts.

# ─── Chain identity ─────────────────────────────────────────────
MORPHIT_RELAY_ACCOUNT={{ morphit_operator_account }}
MORPHIT_RELAY_ACTIVE_KEY_FILE={{ morphit_relay_keystore_path }}
# Note: there is NO MORPHIT_RELAY_PASSPHRASE env var.  Encrypted-
# envelope keys are unlocked via a systemd encrypted credential at
# service start (ADR-0010 §4; morphit-relay.service uses
# LoadCredentialEncrypted=).  Putting the passphrase in env would
# defeat the encrypted-envelope design.

# ─── HTTP bind ──────────────────────────────────────────────────
MORPHIT_RELAY_LISTEN_HOST={{ morphit_relay_bind_host }}
MORPHIT_RELAY_LISTEN_PORT={{ morphit_relay_bind_port }}

# ─── Public origin (invite links / web-push / CORS) ─────────────
# cp663 #6 — the URL this relay is publicly reachable at (behind
# BunkerWeb).  MUST be set: the code default is a placeholder host that
# does not resolve, so leaving it unset breaks invite links + web-push.
{% if morphit_tor_only | default(false) %}
# Tor-only: set to the .onion by the playbook post_tasks (onion unknown here).
MORPHIT_RELAY_PUBLIC_ORIGIN=
{% else %}
MORPHIT_RELAY_PUBLIC_ORIGIN=https://{{ morphit_domain }}
{% endif %}

# ─── Blurt RPC (v1.18.0, F32) ──────────────────────────────────
# The relay BROADCASTS — signups, relayed transfers — so it reaches the chain as
# often as the indexer does, and it used to be left out of this: no line here,
# so it took the built-in clearnet default even on a tor-only node, and no
# hidden endpoints or proxy settings, so it could not have used one anyway.
# The same seed lists as indexer.env.j2 (group_vars), through the same local
# Tor SOCKS / i2pd proxies.
{% set _hidden_onion = morphit_hidden_rpc_seed_onion if (enable_tor | default(true)) else [] %}
{% set _hidden_i2p = morphit_hidden_rpc_seed_i2p if (enable_i2pd | default(true)) else [] %}
{% if morphit_tor_only | default(false) %}
# Tor-only: NO clearnet RPC, exactly as the indexer. Empty here with hidden
# endpoints below makes the relay HIDDEN-ONLY: it refuses public clearnet
# outright (fail-closed) and sends no Web Push.
MORPHIT_RELAY_BLURT_RPC=
{% endif %}
MORPHIT_RELAY_HIDDEN_RPC_ENDPOINTS={{ morphit_relay_hidden_rpc_endpoints | default(morphit_indexer_hidden_rpc_endpoints | default((_hidden_onion + _hidden_i2p) | join(','))) }}
MORPHIT_RELAY_TOR_SOCKS=127.0.0.1:{{ morphit_tor_socks_port | default(9050) }}
MORPHIT_RELAY_I2P_HTTP_PROXY=127.0.0.1:{{ morphit_i2p_http_proxy_port | default(4444) }}

# ─── Database ───────────────────────────────────────────────────
# cp663 #5 — the relay + indexer SHARE ONE database.  The relay's tables
# (push_pending, relay_pending_transfers, push_subscriptions, ...) are
# part of the indexer's SINGLE unified migration set, which runs only
# against the indexer DB — so the relay must connect to that same DB, or
# it hits "relation does not exist".  (A dedicated morphit_relay DB would
# be schemaless; the postgres role no longer creates one.)
MORPHIT_RELAY_DATABASE_URL=postgresql://{{ postgres_indexer_user }}:{{ postgres_indexer_password }}@localhost:{{ postgres_port }}/{{ postgres_indexer_db }}

# ─── Trusted-proxy IPs (§32 CRITICAL — see group_vars/all.yml) ──
MORPHIT_RELAY_TRUSTED_PROXY_IPS={{ morphit_relay_trusted_proxy_ips }}

# ─── Diamond-hardened squatter defense (§38.7) ──────────────────
MORPHIT_RELAY_SIGNUP_ENABLED={{ morphit_relay_signup_enabled | string | lower }}
MORPHIT_RELAY_SIGNUP_DAILY_CEILING={{ morphit_relay_signup_daily_ceiling }}
MORPHIT_RELAY_CREATE_SPACING_MINUTES={{ morphit_relay_create_spacing_minutes }}
MORPHIT_RELAY_ALTCHA_TRIGGER_COUNT={{ morphit_relay_altcha_trigger_count }}
MORPHIT_RELAY_ALTCHA_MAXNUMBER={{ morphit_relay_altcha_maxnumber }}
MORPHIT_RELAY_HIGHVALUE_NAME_POLICY={{ morphit_relay_highvalue_name_policy }}
MORPHIT_RELAY_HIGHVALUE_SHORT_NAME_THRESHOLD={{ morphit_relay_highvalue_short_name_threshold }}
MORPHIT_RELAY_SEQUENTIAL_DETECTOR_ENABLED={{ morphit_relay_sequential_detector_enabled | string | lower }}
MORPHIT_RELAY_SEQUENTIAL_THRESHOLD={{ morphit_relay_sequential_threshold }}
MORPHIT_RELAY_SEQUENTIAL_WINDOW_MS={{ morphit_relay_sequential_window_ms }}
MORPHIT_RELAY_SEQUENTIAL_MIN_PREFIX={{ morphit_relay_sequential_min_prefix }}

# ─── CORS (Origin allowlist — §17) ──────────────────────────────
{% if morphit_tor_only | default(false) %}
MORPHIT_RELAY_ALLOWED_ORIGINS=
{% else %}
MORPHIT_RELAY_ALLOWED_ORIGINS=https://{{ morphit_domain }}
{% endif %}

# Operator-tunable knobs not in this template should be added
# here following the same {{ "{{ ansible_var }}" }} pattern;
# see ops/env/relay.env.example for the full list of vars the
# relay accepts.
