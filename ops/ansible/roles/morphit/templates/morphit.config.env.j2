# Operator-tunable config, read by `morphit-ops` (register / edit / doctor) when
# it is run BY HAND from {{ morphit_repo_path }}.  loadInstanceEnv loads this file
# through the operator-config allowlist (OS env wins; file fills what is missing).
#
# The running indexer already gets these values from /etc/morphit/indexer.env.
# This file exists so a manual `sudo morphit-ops register` — which reads
# {{ morphit_repo_path }}/morphit.config.env, NOT /etc/morphit/*.env — finds the
# instance identity it must broadcast (name + public origin + operator tag).
MORPHIT_INSTANCE_NAME={{ morphit_instance_name }}
MORPHIT_INSTANCE_ORIGIN=https://{{ morphit_domain }}
MORPHIT_INSTANCE_OPERATOR_TAG={{ morphit_operator_tag }}
{% if morphit_instance_tagline | default('') | length > 0 %}MORPHIT_INSTANCE_TAGLINE={{ morphit_instance_tagline }}
{% endif %}
{% if morphit_instance_contact_url | default('') | length > 0 %}MORPHIT_INSTANCE_CONTACT_URL={{ morphit_instance_contact_url }}
{% endif %}
{% if morphit_instance_tor_address | default('') | length > 0 %}MORPHIT_INSTANCE_TOR_ADDRESS={{ morphit_instance_tor_address }}
{% endif %}
{% if morphit_instance_i2p_b32_address | default('') | length > 0 %}MORPHIT_INSTANCE_I2P_B32_ADDRESS={{ morphit_instance_i2p_b32_address }}
{% endif %}
