# /etc/morphit/fail2ban-monitor.env
# Generated by Ansible morphit-ansible/roles/fail2ban_monitor/.

{% if fail2ban_ban_critical is defined %}
MORPHIT_FAIL2BAN_BAN_CRITICAL={{ fail2ban_ban_critical }}
{% endif %}
{% if fail2ban_ban_warn is defined %}
MORPHIT_FAIL2BAN_BAN_WARN={{ fail2ban_ban_warn }}
{% endif %}

{% if fail2ban_per_jail is defined %}
# Per-jail overrides — env var name is
# MORPHIT_FAIL2BAN_<UPPERCASE-JAIL-NAME>_<CRITICAL|WARN>.
# Hyphens in jail names → underscores in env var names.
{% for jail, thresholds in fail2ban_per_jail.items() %}
{% set var_jail = jail | upper | replace('-', '_') %}
{% if thresholds.critical is defined %}
MORPHIT_FAIL2BAN_{{ var_jail }}_CRITICAL={{ thresholds.critical }}
{% endif %}
{% if thresholds.warn is defined %}
MORPHIT_FAIL2BAN_{{ var_jail }}_WARN={{ thresholds.warn }}
{% endif %}
{% endfor %}
{% endif %}
