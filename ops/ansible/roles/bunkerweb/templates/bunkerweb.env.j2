# Managed by Ansible — BunkerWeb configuration.
# Reference: https://docs.bunkerweb.io/latest/settings/

# ─── Server identity ────────────────────────────────────────────
SERVER_NAME={{ morphit_domain }}
SERVER_TYPE=http
MULTISITE=no

# ─── TLS (host-mounted Let's Encrypt cert) ──────────────────────
USE_LETS_ENCRYPT=no
USE_CUSTOM_SSL=yes
CUSTOM_SSL_CERT=/etc/letsencrypt/live/{{ morphit_domain }}/fullchain.pem
CUSTOM_SSL_KEY=/etc/letsencrypt/live/{{ morphit_domain }}/privkey.pem

# Redirect plain HTTP to HTTPS.
AUTO_REDIRECT_HTTP_TO_HTTPS=yes

# ─── Upstream — morphit relay + indexer on the host ─────────────
USE_REVERSE_PROXY=yes
REVERSE_PROXY_HOST_1=http://host.docker.internal:{{ morphit_relay_bind_port }}
REVERSE_PROXY_URL_1=/v1/relay/
REVERSE_PROXY_HOST_2=http://host.docker.internal:{{ morphit_indexer_bind_port }}
REVERSE_PROXY_URL_2=/v1/

# ─── WAF: OWASP CRS ─────────────────────────────────────────────
USE_MODSECURITY=yes
USE_MODSECURITY_CRS=yes
MODSECURITY_CRS_VERSION=4
MODSECURITY_CRS_PARANOIA={{ bunkerweb_crs_paranoia }}

# ─── Rate limiting at the WAF layer (cheap; relay still has its
#     own deeper limits) ─────────────────────────────────────────
USE_LIMIT_REQ=yes
LIMIT_REQ_RATE=60r/m
LIMIT_REQ_URL=/v1/

# ─── Anti-bot: referer-none rule on the invite endpoint
#     (§38.6 item d) ────────────────────────────────────────────
USE_BLOCK_REFERRER_NONE=yes
BLOCK_REFERRER_NONE_URL=/v1/relay/account/invite

# ─── Country block (§38.6 item b) ───────────────────────────────
{% if bunkerweb_block_countries | length > 0 %}
BLACKLIST_COUNTRY={{ bunkerweb_block_countries | join(' ') }}
{% else %}
# No country blocks configured.  Add ISO-3166-1 alpha-2 codes to
# bunkerweb_block_countries in group_vars/all.yml to enable.
{% endif %}

# ─── ASN block (§38.6 item c) ───────────────────────────────────
{% if bunkerweb_block_asns | length > 0 %}
BLACKLIST_ASN={{ bunkerweb_block_asns | join(' ') }}
{% else %}
# No ASN blocks configured.
{% endif %}

# ─── Real-IP forwarding ─────────────────────────────────────────
# BunkerWeb terminates TLS and forwards X-Forwarded-For to the
# relay.  The relay's trusted-proxy IPs setting must include the
# BunkerWeb container's IP from this network (172.20.0.0/16 per
# docker-compose.yml).
USE_REAL_IP=yes
REAL_IP_FROM=0.0.0.0/0
REAL_IP_HEADER=X-Forwarded-For

# ─── Generic hardening ──────────────────────────────────────────
DISABLE_DEFAULT_SERVER=yes
SERVER_TOKENS=off
USE_GZIP=yes
USE_BROTLI=yes
USE_ANTIBOT=captcha
ANTIBOT_URI=/v1/relay/account/invite
