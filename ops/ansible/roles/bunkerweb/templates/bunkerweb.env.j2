# Managed by Ansible — BunkerWeb configuration.
# Reference: https://docs.bunkerweb.io/latest/settings/

# ─── Server identity ────────────────────────────────────────────
SERVER_NAME={{ morphit_domain }}
SERVER_TYPE=http
MULTISITE=no

# ─── TLS (host-mounted Let's Encrypt cert) ──────────────────────
# The certificate comes from this server's own certbot (Let's Encrypt, the
# one outside service a clearnet node needs); BunkerWeb's ACME client is off.
AUTO_LETS_ENCRYPT=no
USE_CUSTOM_SSL=yes
CUSTOM_SSL_CERT=/etc/letsencrypt/live/{{ morphit_domain }}/fullchain.pem
CUSTOM_SSL_KEY=/etc/letsencrypt/live/{{ morphit_domain }}/privkey.pem

# Redirect plain HTTP to HTTPS.
AUTO_REDIRECT_HTTP_TO_HTTPS=yes

# ─── Scheduler <-> instance API ─────────────────────────────────
# The scheduler runs in a SEPARATE container.  BunkerWeb 1.5 finds the
# instance through the Docker socket (the image's bunkerweb.INSTANCE
# label — see the scheduler's socket mount in docker-compose.yml) and
# pushes every generated config to the instance's API.  That API trusts
# only 127.0.0.0/8 by default, but the scheduler reaches it from another
# container on this network's bridge (172.20.0.0/16 per
# docker-compose.yml), so that CIDR MUST be in API_WHITELIST_IP or the
# instance refuses every config push ("Sending nginx configs failed").
API_WHITELIST_IP=127.0.0.0/8 172.20.0.0/16

# ─── Upstream — everything goes to the morphit frontend container ─
# NOTE: validate this reverse-proxy wiring on a real host (it
# can't run in the project's CI sandbox) — see OPERATIONS.md §32.
# BunkerWeb proxies EVERY path to the `frontend` nginx container,
# which serves the SvelteKit static build AND reverse-proxies the
# API paths (/v1/, /relay/, /rss/, SSE) to the relay + indexer on the
# host.  See ops/bunkerweb/frontend/nginx.conf (mirrors web.conf);
# the relay/indexer ports live there, not here.
USE_REVERSE_PROXY=yes
# :8088 is the frontend's EDGE listener: only requests arriving there (from
# Docker's address pool) have their X-Real-IP believed, so each visitor gets
# their own rate-limit bucket. Tor/I2P use :80 and cannot set it (v1.20.0).
REVERSE_PROXY_HOST=http://frontend:8088

# ─── WAF: OWASP CRS ─────────────────────────────────────────────
USE_MODSECURITY=yes
USE_MODSECURITY_CRS=yes
MODSECURITY_CRS_VERSION=4
MODSECURITY_CRS_PARANOIA={{ bunkerweb_crs_paranoia }}

# ─── Request body ceiling ───────────────────────────────────────
# Must sit ABOVE the relay's own 64 KB body cap so a legitimate
# broadcast reaches the app (which is the authoritative limiter). An
# avatar broadcast is ~7.6 KB; BunkerWeb's small default 413'd it
# BEFORE the relay ever saw it (v1.16.9, timeapp). 1m gives headroom;
# the relay's 64 KB stays the real cap.
MAX_CLIENT_SIZE=1m

# ─── WAF exemption: the JSON APIs (/v1/ indexer, /relay/ relay) ──
# These endpoints are machine-to-machine JSON — signed transactions,
# base64 avatar blobs, etc. — validated by the indexer/relay's OWN
# op-allowlist, schema, invite gate, altcha, and per-endpoint rate
# limits. OWASP CRS at paranoia {{ bunkerweb_crs_paranoia }}
# false-positives on that payload shape and returned 403 on a
# legitimate avatar broadcast (v1.16.7). Turn the ModSecurity rule
# engine OFF for those API prefixes only; the human-facing web surface
# keeps full WAF protection.
CUSTOM_CONF_MODSEC_morphit_json_api_off=SecRule REQUEST_URI "@rx ^/(v1|relay)/" "id:1990001,phase:1,t:none,nolog,pass,ctl:ruleEngine=Off"

# ─── Rate limiting at the WAF layer — COARSE ceiling only; the
#     indexer/relay enforce finer per-endpoint per-IP limits ───────
# Must sit ABOVE the indexer's own limits (120 r/m list / 600 r/m
# single-record) so the app's limiter binds first. The old 60 r/m
# (1 r/s) was tighter than a normal SvelteKit page-load burst of
# /v1/* calls, producing 429s that bad-behavior counted into IP bans.
# BAD_BEHAVIOR_STATUS_CODES below excludes 429 so a burst
# can never escalate to a ban.
USE_LIMIT_REQ=yes
LIMIT_REQ_URL_1=/v1/
LIMIT_REQ_RATE_1=1800r/m
LIMIT_REQ_URL_2=/relay/
LIMIT_REQ_RATE_2=120r/m

# ─── Bad-behavior bans: SPA/PWA + public-API safe ───────
# Count only genuinely-anomalous codes. The default set bans real
# users because it counts 429 (rate-limit burst), 403 (which is also
# the ban's OWN response → self-perpetuating ban), and 404 (normal
# PWA/SPA asset/manifest/icon probing). It also must NOT count 400:
# the /v1/ + /relay/ JSON APIs return 400 routinely when the indexer/
# relay rejects an invalid/expired/malformed broadcast — normal use,
# not malice — and counting it banned legitimate traders (v1.16.9,
# timeapp: the avatar-broadcast 403 was a bad-behavior ban on stacked
# 400s). See OPERATIONS.md §38.6.
USE_BAD_BEHAVIOR=yes
BAD_BEHAVIOR_STATUS_CODES=401 405 444
BAD_BEHAVIOR_THRESHOLD=50
BAD_BEHAVIOR_COUNT_TIME=60
BAD_BEHAVIOR_BAN_TIME=3600

# ─── Country block (§38.6 item b) ───────────────────────────────
# Looked up in a GeoIP database on this server; nothing leaves the box.
{% if bunkerweb_block_countries | length > 0 %}
BLACKLIST_COUNTRY={{ bunkerweb_block_countries | join(' ') }}
{% else %}
# No country blocks configured.  Add ISO-3166-1 alpha-2 codes to
# bunkerweb_block_countries in group_vars/all.yml to enable.
{% endif %}

# ─── Nothing about a visitor leaves this server ─────────────────
# BunkerWeb 1.5 turns these on by default.  Each one discloses visitors
# to someone else, so Morphit turns every one off (and `morphit-ops
# upgrade` does the same on installed servers, then checks the settings
# BunkerWeb really runs with):
#   USE_BUNKERNET          every request BunkerWeb blocks would be sent to
#                          api.bunkerweb.io with the visitor's address, the
#                          URL and all request headers.
#   USE_DNSBL              every visitor address would be looked up at
#                          Spamhaus, SORBS and blocklist.de.
#   USE_BLACKLIST          a reverse-DNS query for every visitor address,
#                          and Tor users turned away (403) from a Tor-exit
#                          list.  ASN blocks need this plugin, so Morphit
#                          has none: they also turn away VPN users.
#   USE_WHITELIST          another reverse-DNS query for every visitor.
#   USE_GREYLIST           (off by default) the same, kept off.
#   SEND_ANONYMOUS_REPORT  a daily report about this server to BunkerWeb.
#   USE_REVERSE_SCAN       (off by default) connects back to each visitor's
#                          own address to probe its ports; kept off.
#   USE_METRICS            keeps the last 100 blocked requests (address, full
#                          URL, user agent) in memory with no time limit.
#   (Country blocks, BLACKLIST_COUNTRY, need none of these: the GeoIP file is
#   on this server.  Plain address blocks without the blacklist plugin: a
#   CUSTOM_CONF_SERVER_HTTP_<name>=deny <address or network>; line — nginx
#   refuses them itself, with no reverse-DNS query.)
#   EXTERNAL_PLUGIN_URLS   plugin downloads; none.
# Three of BunkerWeb's daily jobs reach the internet whatever these say
# (GeoIP databases from db-ip.com, its release list from api.github.com,
# "preview" Pro plugins from assets.bunkerity.com).  docker-compose.yml
# gives the scheduler Morphit's job lists instead (ops/bunkerweb/scheduler/),
# so BunkerWeb contacts nobody; its GeoIP files are the ones in its image.
USE_BUNKERNET=no
USE_DNSBL=no
USE_BLACKLIST=no
USE_WHITELIST=no
USE_GREYLIST=no
SEND_ANONYMOUS_REPORT=no
USE_REVERSE_SCAN=no
USE_METRICS=no
EXTERNAL_PLUGIN_URLS=

# ─── Real-IP forwarding ─────────────────────────────────────────
# BunkerWeb IS the public edge: the address it
# sees on the socket is the real visitor, so it must NOT believe a
# visitor's X-Forwarded-For. (This used to be USE_REAL_IP=yes with
# REAL_IP_FROM=0.0.0.0/0, which trusted that header from the whole
# internet: anyone could pick their own address per request and walk
# past BunkerWeb's own bans and rate limits, and the relay's per-IP
# signup limits.)  BunkerWeb passes the visitor on to the frontend as
# X-Real-IP; the frontend hands exactly that one address to the relay
# (ops/bunkerweb/frontend/nginx.conf).  The relay sees the FRONTEND
# container as its immediate peer, so its MORPHIT_RELAY_TRUSTED_PROXY_IPS
# must include this Docker network's CIDR (172.20.0.0/16 per
# docker-compose.yml).
# Only if you put a CDN or load balancer IN FRONT of BunkerWeb: set
# USE_REAL_IP=yes and REAL_IP_FROM to THAT proxy's address ranges only
# (never 0.0.0.0/0).  `morphit-ops upgrade` turns a 0.0.0.0/0 setting off.
USE_REAL_IP=no

# ─── Generic hardening ──────────────────────────────────────────
DISABLE_DEFAULT_SERVER=yes
SERVER_TOKENS=off
USE_GZIP=yes
USE_BROTLI=yes
# NO global antibot.  BunkerWeb's USE_ANTIBOT is SITE-WIDE:
# it challenges EVERY visitor to the whole marketplace, and ANTIBOT_URI
# only sets where the challenge renders — pointing it at a live API path
# (/relay/v1/account/invite) both gated the entire site behind a captcha
# AND shadowed that real relay endpoint.  The invite endpoint is protected
# by the relay itself (its ALTCHA proof-of-work and signup limits).  If a
# deliberate site-wide gate is ever wanted, use a local mode (captcha,
# cookie or javascript — recaptcha/hcaptcha/turnstile load a third
# party's script in every visitor's browser) and set ANTIBOT_URI to a
# DEDICATED path (e.g. /__antibot), never a live endpoint.
USE_ANTIBOT=no

# ─── Security headers (v1.20.0, C2) ─────────────────────────────
# The same values ops/nginx/web.conf and ops/bunkerweb/frontend/nginx.conf
# send (scripts/csp-header-consistency-smoke.ts keeps all copies identical).
# The frontend container sends CSP, Permissions-Policy and X-Frame-Options
# itself and BunkerWeb keeps those upstream values (KEEP_UPSTREAM_HEADERS
# default); these apply to everything BunkerWeb answers on its own (its error
# and ban pages) and set Referrer-Policy.  Without them BunkerWeb 1.5 sends
# its defaults: a CSP with no script-src/connect-src limit, a Referrer-Policy
# that leaks the origin cross-site, and Permissions-Policy camera=(), which
# would break the QR-login scanner.  Scripts from this origin only (no inline
# script, no eval; 'wasm-unsafe-eval' lets the keystore's WebAssembly run).
# connect-src lists the Blurt RPC nodes the BROWSER calls (DEFAULT_RPC_ENDPOINTS
# in apps/web/src/lib/net/config.ts); NO price API (the browser never calls
# one).
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://rpc.drakernoise.com https://blurtrpc.dagobert.uk https://rpc.blurt.blog https://rpc.beblurt.com https://blurt-rpc.saboin.com; media-src 'none'; object-src 'none'; child-src 'none'; frame-src 'none'; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'
REFERRER_POLICY=no-referrer
X_FRAME_OPTIONS=DENY
PERMISSIONS_POLICY=camera=(self), microphone=(), geolocation=(), interest-cohort=()

# ─── Access log without addresses (v1.20.0, C1 — privacy #1) ─────
# BunkerWeb's default LOG_FORMAT starts with the visitor's address
# ($remote_addr) and its access log goes to the container's stdout, i.e. to
# Docker's log files on disk.  This format keeps what an operator needs to
# read a problem (site, time, method, path without the query string, status,
# size) and nothing that identifies a visitor.  SINGLE-QUOTED on purpose:
# `docker compose` substitutes $variables in an env file, and would otherwise
# turn every $name here into an empty string.  (The compose file also turns
# this container's Docker log off entirely — see docker-compose.yml — because
# BunkerWeb's error and ModSecurity lines name visitors too.)
LOG_FORMAT='$host [$time_local] "$request_method $uri" $status $body_bytes_sent'
{% if morphit_instance_tor_address | default('') | length > 0 %}

# ─── Onion-Location ─────────────────────────────────────
# Advertise this instance's Tor onion to Tor-capable browsers via the
# Onion-Location HTTP HEADER.  Brave reads ONLY the header — it ignores the
# <meta http-equiv="onion-location"> tag the frontend also emits — so without
# this the ".onion available" pill never appears in Brave.  (Tor Browser honours
# the meta tag, so it already shows there; this adds Brave + anything else that
# is header-only.)  Non-Tor browsers (Chrome/Firefox/Safari/Opera) have no Tor
# and cannot reach a .onion, so they simply ignore it — the footer pill / link
# is their discovery path.
#
# Clearnet-only BY CONSTRUCTION: the onion bypasses BunkerWeb entirely
# (Tor → frontend:8090), so BunkerWeb only ever serves clearnet — the
# spec's "must not be emitted on the onion itself / must be HTTPS clearnet"
# rules are satisfied without any host gating.  $request_uri keeps the visitor
# on the same page once redirected onto the onion.
CUSTOM_HEADER=Onion-Location: http://{{ morphit_instance_tor_address }}$request_uri
{% endif %}
