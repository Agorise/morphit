[Unit]
Description=Morphit relay — weekly ACT minting (unattended)
Documentation=https://git.agorise.net/agorise/morphit/src/branch/main/docs/OPERATIONS.md
Documentation=https://git.agorise.net/agorise/morphit/src/branch/main/docs/AUTOMATION-AUDIT.md
After=network-online.target
Wants=network-online.target
# Refuse to run if the relay's main service is in a failed state — a
# broken relay shouldn't be minting more BLURT into ACTs.
After=morphit-relay.service

[Service]
Type=oneshot
User=morphit-relay
Group=morphit-relay
WorkingDirectory=/opt/morphit-relay
EnvironmentFile=/etc/morphit/relay.env

# Unattended-run setup:
#
#   1. Operator decides the weekly count and sets it in
#      /etc/morphit/relay.env:
#          MORPHIT_RELAY_WEEKLY_ACT_COUNT=25
#      Default if unset is 25 (mint-acts.ts reads this when no
#      argv[1] is provided).
#
#   2. Operator stores the active-key passphrase in a root-only
#      file at /etc/morphit/relay.passphrase (mode 0600), or uses
#      `systemd-creds encrypt` to ship an encrypted blob and load
#      it via LoadCredentialEncrypted= below.
#
#   3. The script reads MORPHIT_RELAY_PASSPHRASE_FILE which we
#      point at $CREDENTIALS_DIRECTORY/passphrase.  systemd
#      mounts the credential at /run/credentials/<unit>/passphrase
#      with mode 0400 owned by the service user — readable only
#      by the running service, never persisted on disk under the
#      service's normal filesystem view.
#
# This means the operator's once-per-deploy step is "drop the
# passphrase into a credential" and from then on weekly minting
# happens with no operator action.

# Pass the passphrase file via systemd's LoadCredential mechanism.
# The path on the host can be plaintext-protected via filesystem
# perms (LoadCredential=) or encrypted-at-rest via systemd-creds
# (LoadCredentialEncrypted=).  Operators choose; the env var below
# points the script at whatever ends up mounted.
#
# Default: plaintext file, perm-protected.  Operators with high
# threat models should swap to LoadCredentialEncrypted= and use
# systemd-creds.
LoadCredential=passphrase:/etc/morphit/relay.passphrase
Environment=MORPHIT_RELAY_PASSPHRASE_FILE=%d/passphrase

# Run the script with the unattended count from env.
ExecStart=/usr/bin/env npm exec --silent -- tsx scripts/mint-acts.ts

# Logging: stdout/stderr to journal, tagged for filtering.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=morphit-relay-mint-acts

# ─── Hardening ───────────────────────────────────────────────────────
# Same posture as the relay service.  The mint script does network
# I/O (RPC) and reads the credential, nothing else.

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/morphit /opt/morphit-relay
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
LockPersonality=yes
# V8 JIT — same constraint as the relay service.
MemoryDenyWriteExecute=no
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

# Resource caps.  Mint runs are bursty over a few seconds; 256 MiB
# is comfortable.
MemoryMax=256M
TasksMax=64

# This is a one-shot.  No restart on failure — the timer fires
# again next week and will retry then.  An immediate-retry loop
# would be hostile to a flaky upstream.
Restart=no

# Timeout: 25 ACTs × ~3-second block time × ~3 retry margin ≈ 4 min.
# Cap at 10 min to absorb network jitter.
TimeoutStartSec=600

[Install]
# Not directly enabled — the timer enables it.  WantedBy here so
# `systemctl enable morphit-relay-mint-acts.timer` works.
WantedBy=multi-user.target
