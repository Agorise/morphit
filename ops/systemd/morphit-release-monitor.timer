[Unit]
Description=Morphit release monitor timer — 6h check for new releases
Documentation=https://git.agorise.net/agorise/morphit
Requires=morphit-release-monitor.service

[Timer]
# Every 6h, starting 15 minutes after boot.  Smaller cadence
# would be wasted (releases are infrequent); larger cadence
# could leave operators days behind a critical fix.
OnBootSec=15min
OnUnitActiveSec=6h
RandomizedDelaySec=10min
Persistent=true
Unit=morphit-release-monitor.service

[Install]
WantedBy=timers.target
