[Unit]
Description=Morphit release monitor timer — twice-a-day check for new releases
Documentation=https://git.agorise.net/agorise/morphit
# No Requires= on the service: it would start a check every time the timer
# starts — at every boot, before the indexer it reads is up, and at every
# `enable --now` — on top of the timer's own runs (review 2026-10-08).

[Timer]
# Twice a day, starting 15 minutes after boot (release checks run at most
# about twice a day: bandwidth and privacy). The check reads the on-chain
# release record from this node's own indexer, so it normally leaves the box
# not at all. Smaller cadence would be wasted (releases are infrequent).
OnBootSec=15min
OnUnitActiveSec=12h
RandomizedDelaySec=10min
Unit=morphit-release-monitor.service

[Install]
WantedBy=timers.target
